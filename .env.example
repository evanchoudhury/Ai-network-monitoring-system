# ============================================================================
# Sentinel AI — environment configuration (EXAMPLE)
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Placeholders only below.
# ============================================================================

# ---- Application -----------------------------------------------------------
ENVIRONMENT=development            # development | test | production
DEBUG=true
APP_NAME=Sentinel AI
API_PREFIX=/api

# ---- Database --------------------------------------------------------------
# Local dev default is SQLite. For production use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://sentinel:password@db:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# ---- Security (REQUIRED in production) ------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# Comma-separated list of allowed CORS origins (the frontend URL(s)).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# ---- News / evidence providers (OPTIONAL) ---------------------------------
# Leave blank to run with RSS + local-evidence only (no external keys needed).
# NEWSAPI_KEY: a NewsAPI.org key. When set, a "NewsAPI Top Headlines" source is
# auto-seeded and ingested alongside the RSS feeds.
NEWSAPI_KEY=
# GOOGLE_FACTCHECK_API_KEY: a Google Cloud **API key** (Credentials -> API key,
# with the "Fact Check Tools API" enabled) — NOT an OAuth 2.0 client secret
# JSON. An OAuth client (client_id/client_secret) will not work here.
GOOGLE_FACTCHECK_API_KEY=
HTTP_USER_AGENT=SentinelAI/1.0 (+https://github.com/your-org/sentinel-ai)
HTTP_TIMEOUT_SECONDS=15

# ---- Optional external LLM (DISABLED by default) --------------------------
# The core pipeline is deterministic and needs NO LLM. Enable only to opt in.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ---- Budget & resource controls -------------------------------------------
# NOTE: these cap application-level model usage & ESTIMATED AI cost. They do
# NOT guarantee a maximum total cloud bill.
BUDGET_DAILY_USD=1.00
BUDGET_MONTHLY_USD=10.00
BUDGET_MAX_MODEL_REQUESTS_PER_DAY=500
BUDGET_MAX_TOKENS_PER_DAY=200000
MAX_ARTICLE_LENGTH_CHARS=50000
MAX_ARTICLES_PER_BATCH=50
WORKER_MAX_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
BUDGET_FAIL_CLOSED=true

# ---- Retention -------------------------------------------------------------
METRIC_RETENTION_DAYS=30
ARTICLE_RETENTION_DAYS=90
MAX_STORED_ARTICLES=50000

# ---- Background workers ----------------------------------------------------
ENABLE_SCHEDULER=true
NEWS_INGEST_INTERVAL_MINUTES=30
ANOMALY_SCAN_INTERVAL_MINUTES=5
HEALTH_CHECK_INTERVAL_MINUTES=2

# ---- Anomaly detection -----------------------------------------------------
ANOMALY_ZSCORE_THRESHOLD=3.5
ANOMALY_MIN_BASELINE_POINTS=12
ANOMALY_BASELINE_WINDOW=48

# ---- Frontend (Vite) build-time variable ----------------------------------
# Set to your deployed backend URL in production.
VITE_API_BASE_URL=http://localhost:8000
