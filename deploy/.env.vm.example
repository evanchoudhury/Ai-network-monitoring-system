# Sentinel AI — VM backend environment (EXAMPLE). Copy to deploy/.env.
# NEVER commit the real deploy/.env (it is git-ignored). Placeholders only here.

# ---- Required ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
POSTGRES_PASSWORD=change-me-db-password

# The backend API's own HTTPS domain (DNS -> this VM). Caddy gets a cert for it.
API_DOMAIN=api.example.com

# Your Vercel frontend origin(s), comma-separated (for CORS). No trailing slash.
CORS_ORIGINS=https://your-app.vercel.app

# ---- Optional provider keys (leave blank to use RSS + local evidence only) ----
NEWSAPI_KEY=
# A Google Cloud API key with the Fact Check Tools API enabled (NOT an OAuth client).
GOOGLE_FACTCHECK_API_KEY=

# ---- Optional DB identity (defaults are fine) ----
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
